{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zorveus:manifest:1",
  "title": "Zorveus manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "app"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "app": {
      "$ref": "#/$defs/app"
    },
    "keys": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/alias"
      },
      "additionalProperties": {
        "$ref": "#/$defs/key"
      }
    },
    "routingKeys": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/alias"
      },
      "additionalProperties": {
        "$ref": "#/$defs/router"
      }
    },
    "serviceKeys": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/alias"
      },
      "additionalProperties": {
        "$ref": "#/$defs/serviceKey"
      }
    },
    "providerCredentials": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/alias"
      },
      "additionalProperties": {
        "$ref": "#/$defs/providerCredential"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "pattern": "^\\S+$"
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+:[a-z_*]+$"
      }
    },
    "decimal": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "nullableDecimal": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "cap": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "period"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/decimal"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "period": {
          "enum": [
            "daily",
            "monthly",
            "lifetime"
          ]
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "allowedModels": {
          "$ref": "#/$defs/models"
        },
        "allowedScopes": {
          "$ref": "#/$defs/scopes"
        },
        "creditUnitsPerUsd": {
          "$ref": "#/$defs/nullableDecimal"
        },
        "productUserChargeMultiplier": {
          "$ref": "#/$defs/decimal"
        },
        "oauth": {
          "$ref": "#/$defs/oauth"
        },
        "consent": {
          "$ref": "#/$defs/consent"
        }
      },
      "if": {
        "not": {
          "required": [
            "id"
          ]
        }
      },
      "then": {
        "required": [
          "name",
          "allowedModels"
        ]
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "allowedModels": {
          "$ref": "#/$defs/models"
        },
        "creditMode": {
          "enum": [
            "disabled",
            "track_only",
            "enforce_if_present",
            "enforce"
          ]
        },
        "overrunPolicy": {
          "enum": [
            "limit_output",
            "allow_overrun",
            "carry_overrun_forward"
          ]
        },
        "productUserChargeMultiplier": {
          "$ref": "#/$defs/nullableDecimal"
        },
        "cap": {
          "$ref": "#/$defs/cap"
        }
      },
      "if": {
        "not": {
          "required": [
            "id"
          ]
        }
      },
      "then": {
        "required": [
          "name"
        ]
      }
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "members": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/alias"
          }
        },
        "defaultSelector": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9_-]{1,64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "id"
              ]
            }
          },
          "then": {
            "required": [
              "name",
              "members"
            ],
            "properties": {
              "members": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "members"
            ],
            "properties": {
              "members": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "required": [
              "defaultSelector"
            ],
            "properties": {
              "defaultSelector": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "serviceKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        },
        "scopes": {
          "$ref": "#/$defs/scopes"
        }
      },
      "if": {
        "not": {
          "required": [
            "id"
          ]
        }
      },
      "then": {
        "required": [
          "name",
          "scopes"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    "providerCredential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "provider": {
          "enum": [
            "openai",
            "anthropic",
            "gemini",
            "azure",
            "vertex_ai",
            "nvidia_nim",
            "typesafe"
          ]
        },
        "secretFromEnv": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "secretKind": {
          "enum": [
            "api_key",
            "service_account_json",
            "azure_ad_token"
          ]
        },
        "providerConfig": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "api_base": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "api_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "base_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "project": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "location": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "routingMode": {
          "enum": [
            "manual_grant_only",
            "auto_resolve",
            "disabled"
          ]
        },
        "defaultModelPolicy": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^\\S+$"
          }
        }
      },
      "if": {
        "not": {
          "required": [
            "id"
          ]
        }
      },
      "then": {
        "required": [
          "name",
          "provider",
          "secretFromEnv"
        ]
      },
      "dependentRequired": {
        "secretKind": [
          "secretFromEnv"
        ]
      }
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientType": {
          "enum": [
            "public",
            "confidential"
          ]
        },
        "redirectUris": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "pattern": "^https?://[^\\s#]+$"
          }
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultCap": {
          "$ref": "#/$defs/cap"
        },
        "minimumCapAmount": {
          "$ref": "#/$defs/nullableDecimal"
        },
        "maximumCapAmount": {
          "$ref": "#/$defs/nullableDecimal"
        },
        "allowUnlimitedCap": {
          "type": "boolean"
        }
      }
    }
  }
}
