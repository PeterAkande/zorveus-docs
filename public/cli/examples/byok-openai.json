{
  "version": 1,
  "app": {
    "name": "OpenAI document processor",
    "allowedModels": [
      "openai/gpt-4o-mini"
    ]
  },
  "keys": {
    "processor": {
      "name": "Processing backend",
      "creditMode": "enforce_if_present",
      "overrunPolicy": "limit_output",
      "cap": {
        "amount": "50",
        "currency": "USD",
        "period": "monthly"
      }
    }
  },
  "providerCredentials": {
    "openai": {
      "name": "OpenAI primary",
      "provider": "openai",
      "secretFromEnv": "OPENAI_API_KEY",
      "routingMode": "auto_resolve",
      "defaultModelPolicy": [
        "openai/gpt-4o-mini"
      ]
    }
  }
}
